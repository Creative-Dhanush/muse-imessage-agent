# ─────────────────────────────────────────────────────────────
# Muse — environment variables.  Copy to .env and fill in.
# ─────────────────────────────────────────────────────────────

# ── Photon / Spectrum (REQUIRED for iMessage) ────────────────
# Get these at https://app.photon.codes → your project → Settings
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Develop with ZERO Photon setup: chat with Muse in your terminal instead of iMessage.
# MUSE_TERMINAL=1

# ── LLM (REQUIRED: one of these) ─────────────────────────────
LLM_PROVIDER=openai            # openai | anthropic
# LLM_MODEL=gpt-4o             # default: gpt-4o (openai) / claude-sonnet-4-5 (anthropic). Try gpt-4o-mini to go cheaper.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Any OpenAI-compatible provider (OpenRouter, Groq, Together, local Ollama...):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Voice-note transcription uses OPENAI_API_KEY (+ ffmpeg for iMessage .caf files).
# TRANSCRIPTION_MODEL=whisper-1

# ── Web search (OPTIONAL, pick one; otherwise falls back to keyless DuckDuckGo) ──
# Tavily: https://tavily.com (free tier) — best quality, includes a direct answer
# TAVILY_API_KEY=
# Brave:  https://brave.com/search/api (free tier)
# BRAVE_API_KEY=

# ── Behaviour (all optional) ─────────────────────────────────
# MUSE_NAME=Muse
# DEFAULT_TIMEZONE=America/Los_Angeles   # used until the user tells Muse where they live
# MUSE_DB_PATH=./data/muse.db            # use :memory: for no persistence
# MUSE_STREAMING=false                   # true = reply text streams live by editing the bubble in place
# MUSE_HISTORY_TURNS=24                  # how many recent exchanges Muse remembers per chat
# MUSE_DEBOUNCE_MS=1400                  # wait this long to merge rapid-fire texts into one turn
# MUSE_MAX_STEPS=8                       # max tool-calling steps per turn
# MUSE_ALLOWED_SENDERS=+15551234567,friend@example.com   # lock Muse to specific people (great for demos)
# LOG_LEVEL=info                         # debug | info | warn | error
