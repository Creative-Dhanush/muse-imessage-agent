{
  "name": "muse-imessage-agent",
  "version": "1.0.0",
  "description": "Muse — a personal AI agent that lives in iMessage, built on Photon Spectrum.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:terminal": "MUSE_TERMINAL=1 bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.72",
    "@ai-sdk/openai": "^4.0.84",
    "ai": "^7.0.128",
    "luxon": "^3.7.2",
    "mathjs": "^15.2.0",
    "spectrum-ts": "^12.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/luxon": "^3.7.6",
    "typescript": "^7.0.2"
  }
}
